# TrueCapture Backend — Environment Variables
# Copy this file to backend/.env and fill in your values.
# Never commit .env to version control.

# ── DeDi.global key registry ──────────────────────────────────────
# Your API key from https://dedi.global — used to register your public
# signing key on startup so verifiers can look it up independently.
DEDI_API_KEY=your_dedi_api_key_here

# Your DeDi namespace (e.g. "bbc", "reuters", "your-org").
# Created in the DeDi dashboard under your account.
DEDI_NAMESPACE=your-org-namespace

# The registry name within your namespace. Leave as "signing-keys"
# unless you have a specific reason to use a different name.
DEDI_REGISTRY=signing-keys

# The record id/name your public key is published under in that registry.
# REQUIRED: without it (or with DEDI_API_KEY/DEDI_NAMESPACE only partially set)
# the backend refuses to start, because verification can never reach "authentic"
# for a key it can't look up by record id — files would fall back to "untrusted".
DEDI_RECORD_ID=your-org-key-record

# ── Your organisation ──────────────────────────────────────────────
# Appears in the C2PA manifest embedded in every signed file.
ORG_NAME=Your Organisation Name

# Your public-facing URL. Appears in the DeDi key record.
ORG_URL=https://yourdomain.com

# ── Verify URL ────────────────────────────────────────────────────
# Base URL for verify links included in signed file metadata.
# Should point to your deployed verify page.
VERIFY_BASE_URL=https://verify.yourdomain.com/verify

# ── Abuse controls for the public /sign (C3 / H3) ─────────────────
# CAPTCHA (Cloudflare Turnstile or hCaptcha). When the secret + verify URL are
# set, /sign requires a valid X-Captcha-Token. When the provider + site key are
# set, GET /config advertises them and the sign clients render the widget.
# Leave all four unset to disable CAPTCHA entirely (signs without a token).
CAPTCHA_PROVIDER=turnstile
# PUBLIC site key — served to clients via GET /config (safe to expose).
CAPTCHA_SITE_KEY=
# SECRET key — server-side only; NEVER sent to clients.
CAPTCHA_SECRET=
# Provider siteverify endpoint:
#   Turnstile: https://challenges.cloudflare.com/turnstile/v0/siteverify
#   hCaptcha:  https://api.hcaptcha.com/siteverify
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Comma-separated Origin allowlist for /sign (e.g. https://www.truecapture.global).
# Unset = rely on CAPTCHA + per-IP rate limit only.
ALLOWED_ORIGINS=

# CORS allowed origins (comma-separated). Unset = CORS disabled.
CORS_ORIGINS=

# Max /sign + /verify requests per IP per minute (H3).
RATE_LIMIT_MAX=120

# Set to "true" when running behind a proxy/CDN so the rate limiter keys on the
# real client IP (X-Forwarded-For) instead of the proxy's single IP. NB: the
# limiter is per-process — for multi-instance deployments back it with a shared
# store (e.g. Redis) so the limit is global.
TRUST_PROXY=false

# Max upload size in bytes (default 50 MB).
MAX_FILE_SIZE=52428800

# ── OIDC-bound signing (C3b — optional; authenticated user → content) ─
# When all three are set, POST /sign/session validates a Bearer OIDC token and
# binds the verified user (sub/iss/email) into the manifest. Unset = 401.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=

# ── Server ────────────────────────────────────────────────────────
# Port the Fastify server listens on. Railway sets PORT automatically.
PORT=3000

# Host to bind. 0.0.0.0 required for Railway / Docker deployments.
HOST=0.0.0.0
